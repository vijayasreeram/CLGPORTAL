# ============================================================
# Internship Portal — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# Do NOT commit this file to version control.
# ============================================================

# Flask secret key (change this to a long random string in production)
SECRET_KEY=internship_portal_secure_key_2025_xK9mP3qL

# Upload directories (relative to project root)
CERT_UPLOAD_DIR=data/certificates
RESUME_DIR=data/resumes
TESTS_DIR=data/tests

# Data files
MASTER_CSV=data/master_students.csv
COMPANY_DRIVES_CSV=data/company_drives.csv
CERTIFICATES_CSV=data/certificates.csv
RESULTS_CSV=data/test_results.csv

# ML model paths
SKILL_MODEL_PATH=model/best_model.pkl
SCHEME_MODEL_PATH=model/scheme_predictor_v2_rf.pkl
LABEL_ENCODER_PATH=model/label_encoder.pkl

# HMAC secret for proctor token signing (change in production)
PROCTOR_HMAC_SECRET=proctor_signing_secret_2025_yH7nW2kR

# Flask debug mode (set to False in production)
FLASK_DEBUG=True

# Port
PORT=5000
